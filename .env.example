# Copy to .env and fill in. Never commit .env.

# lite = laptop, no Docker needed | full = use the Docker Compose services
CLAIMSENSE_MODE=lite

# Where datasets live. Default: ./data. Point at Google Drive in Colab:
# CLAIMSENSE_DATA_DIR=/content/drive/MyDrive/claimsense/data

# Where CarDD lives (keep it in Google Drive, not on your laptop).
# Mac with Google Drive for desktop:
# CARDD_DIR=~/Library/CloudStorage/GoogleDrive-<your-email>/My Drive/claimsense/data/public/cardd
# Colab: CARDD_DIR=/content/drive/MyDrive/claimsense/data/public/cardd

# --- LLM ---------------------------------------------------------------------
# rules (no LLM, offline baseline) | gemini | openai_compat (Ollama/vLLM/TGI) | router
LLM_PROVIDER=rules
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_COMPAT_URL=http://localhost:11434/v1
OPENAI_COMPAT_MODEL=qwen2.5:3b

# --- Retrieval ---------------------------------------------------------------
# hashing (no download) | sentence-transformers
EMBEDDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# QDRANT_URL=http://localhost:6333

# --- Models (filled in during Tier 2) -----------------------------------------
# VISION_MODEL_PATH=models/damage.onnx
# FRAUD_MODEL_PATH=models/fraud_lgbm.txt
WHISPER_MODEL=small

# --- Full mode services (docker compose up) -----------------------------------
# DATABASE_URL=postgresql+psycopg://claimsense:claimsense@localhost:5432/claimsense
# S3_ENDPOINT=http://localhost:9000
# REDIS_URL=redis://localhost:6379/0
# PROCESSING=kafka
# KAFKA_BOOTSTRAP=localhost:29092
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- Tracing (self-hosted Langfuse) -------------------------------------------
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
